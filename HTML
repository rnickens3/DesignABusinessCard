<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8">
    <title>Business Card</title>
    <link rel="stylesheet" href="styles.css">
</head>

<body>
    <div class="business-card">
        <img class="profile-image" src="https://cdn.freecodecamp.org/curriculum/labs/flower.jpg" alt="flower">
        <p class="full-name">John Doe</p>
        <p class="designation">Coder</p>
        <p class="company">Best Company</p>
        <hr>
        <p>fakeemail@email.com</p>
        <p>111-111-1111</p>
        <a href="url.com">Portfolio</a>
        <hr>
        <div class="social-media">
            <h2>Connect with me</h2>
            <a href="twitter.com">Twitter</a>
            <a href="LinkedIn.com">LinkedIn</a>
            <a href="GitHub.com">GitHub</a>
        </div>
    </div>
</body>

</html>
